<?xml version="1.0" encoding="utf-8"?>
<!-- 09: the notification draws its own dark card so it reads the same on light and dark shades. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#171613" />
    <stroke android:width="1dp" android:color="#2E2B26" />
    <corners android:radius="16dp" />
</shape>
