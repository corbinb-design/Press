<?xml version="1.0" encoding="utf-8"?>
<!-- 9.1 / 9.2 expanded: countdown hero, the next set, rest progress and the three actions. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/notif_bg" android:padding="14dp">

    <TextView android:id="@+id/kicker" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:fontFamily="monospace" android:textSize="10sp" android:letterSpacing="0.04" android:textColor="#9A9488" android:text="REST" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="center_vertical">
        <Chronometer android:id="@+id/timer" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:fontFamily="serif" android:textSize="40sp" android:textColor="#CCFF00" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical"
            android:gravity="end">
            <TextView android:id="@+id/next_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="monospace" android:textSize="9sp" android:letterSpacing="0.04" android:textColor="#9A9488"
                android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/next_values" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="monospace" android:textSize="13sp" android:textColor="#EEEAE2" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/next_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="#9A9488" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar android:id="@+id/progress" style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="10dp"
        android:max="1000" android:progressDrawable="@drawable/notif_progress" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:layout_marginTop="12dp">
        <TextView android:id="@+id/log" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp"
            android:background="@drawable/notif_pill_lime" android:gravity="center" android:fontFamily="monospace" android:textSize="11sp"
            android:letterSpacing="0.06" android:textColor="#0E0D0B" android:textStyle="bold" android:text="✓  LOG SET" android:maxLines="1" />
        <TextView android:id="@+id/plus15" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp"
            android:layout_marginStart="8dp" android:background="@drawable/notif_pill" android:gravity="center" android:fontFamily="monospace"
            android:textSize="11sp" android:letterSpacing="0.06" android:textColor="#EEEAE2" android:text="+15 SEC" android:maxLines="1" />
        <TextView android:id="@+id/skip" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp"
            android:layout_marginStart="8dp" android:background="@drawable/notif_pill" android:gravity="center" android:fontFamily="monospace"
            android:textSize="11sp" android:letterSpacing="0.06" android:textColor="#EEEAE2" android:text="SKIP" android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
